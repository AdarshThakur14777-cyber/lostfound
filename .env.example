# Copy to .env.local and adjust.

# MongoDB connection. If unset or unreachable, an in-memory MongoDB is started
# automatically (development and tests only).
MONGODB_URI=mongodb://127.0.0.1:27117/lostfound

# 32-byte key, base64 encoded: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Required in production. In development a throwaway key is generated and cached in .data/dev-key.
APP_ENCRYPTION_KEY=

# JWT signing secret. Same rules as APP_ENCRYPTION_KEY.
APP_SESSION_SECRET=

# Where uploaded (EXIF-stripped) photos are stored. Defaults to .data/uploads
UPLOAD_DIR=

# Public base URL used in notifications
APP_URL=http://localhost:3000
